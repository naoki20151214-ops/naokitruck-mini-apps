ottom:.25em}.semicon-card span{font-size:.92em;color:#526071}.semicon-stack{display:grid;gap:12px;margin:1.2em 0}.semicon-stack-item{padding:1em 1.05em;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:0 6px 16px rgba(15,35,63,.06)}.semicon-stack-item b{display:block;color:var(--blue);font-size:1.05em;margin-bottom:.45em}.semicon-tagrow{display:flex;flex-wrap:wrap;gap:8px;margin:.7em 0}.semicon-tag{display:inline-block;padding:.25em .6em;border-radius:999px;border:1px solid #b9d7ff;background:#eef6ff;color:#10233f;font-size:.86em;font-weight:700}.semicon-compare{margin:1.5em 0;overflow-x:auto;border:1px solid var(--line);border-radius:12px}.semicon-compare table{width:100%;border-collapse:collapse;font-size:.92em;margin:0!important}.semicon-compare th{background-color:var(--soft);color:var(--deep);font-weight:700;text-align:left;padding:.85em 1em;border-bottom:1px solid var(--line)}.semicon-compare td{padding:.85em 1em;border-bottom:1px solid var(--line);color:#334155;background-color:#fff}.semicon-compare tr:last-child td{border-bottom:none}.semicon-note{padding:1em 1.2em;border-radius:14px;background:#fff8e7;border:1px solid #fde3a7}.semicon-links{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:1.5em 0}.semicon-linkbox{padding:1em 1.15em;border-radius:14px;border:1px solid var(--line);background:#fff}.semicon-linkbox.next{border-color:#9cc9ff;background:#f0f7ff}.semicon-linkbox h3{margin:.1em 0 .5em}.semicon-linkbox a{font-weight:700;color:#0b63b6}.semicon-sources li{margin-bottom:.45em}.semicon-backtop{position:fixed;right:16px;bottom:86px;z-index:99;display:inline-flex;align-items:center;justify-content:center;min-width:58px;min-height:48px;padding:.35em .6em;border-radius:999px;background:#1f6fbf;color:#fff!important;text-decoration:none;font-weight:700;box-shadow:0 10px 22px rgba(15,35,63,.22)}@media(max-width:760px){.semicon-article{font-size:15.5px}.semicon-article h2{font-size:1.2em!important;margin-top:2em!important;padding:.75em .8em!important;background:#eef7ff!important;color:#10233f!important;border-left:4px solid var(--blue)!important}.semicon-mobile-summary{display:block}.semicon-grid,.semicon-links{grid-template-columns:1fr}.semicon-avatar{width:54px;flex-basis:54px}.semicon-avatar-face{width:44px;height:44px}.semicon-avatar-name{font-size:.72em}.semicon-bubble{max-width:calc(100% - 66px);padding:.85em .95em;border-radius:12px}.semicon-card,.semicon-stack-item,.semicon-linkbox,.semicon-lead,.semicon-note,.semicon-map,.semicon-cta,.semicon-figure,.semicon-compare,.semicon-level{border-radius:10px}.semicon-btnrow{display:grid}.semicon-backtop{right:12px;bottom:82px;min-width:52px;min-height:44px;font-size:.9em}}\n.semicon-level-top{margin-bottom:0}\n.semicon-stars{display:inline-flex;align-items:center;gap:.35em;font-size:1.12em;color:#10233f}\n.semicon-stars .on{color:#f59e0b;letter-spacing:.08em}\n.semicon-stars .off{color:#c3cedc;letter-spacing:.08em}\n.semicon-article .semicon-key{font-weight:700;color:#10233f;background:linear-gradient(transparent 55%,#ffe08a 55%);padding:0 .1em}</p>\n</style>"]