["<style>\n<p>.semicon-article{--blue:#1f6fbf;--deep:#10233f;--soft:#eef6ff;--line:#d7e5f5;--orange:#f59e0b;--green:#16a34a;--purple:#8b5cf6;--red:#ef4444;color:#1f2937;line-height:1.9;font-size:16px}.semicon-article p{margin:0 0 1.05em}.semicon-article h2{margin:2.4em 0 .7em!important;padding:.65em .8em!important;border-left:5px solid var(--blue)!important;border-radius:10px!important;background:linear-gradient(135deg,#eef7ff,#ffffff)!important;font-size:1.5em;color:var(--deep)!important;line-height:1.45!important}.semicon-article h3{margin:1.8em 0 .55em;color:var(--deep);font-size:1.16em}.semicon-lead{padding:1.2em 1.4em;background:linear-gradient(135deg,#eff8ff,#fff);border:1px solid var(--line);border-radius:16px}.semicon-level{margin:1.2em 0;padding:1em 1.15em;border:1px solid #9cc9ff;border-radius:14px;background:#f6fbff}.semicon-level-top{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:.45em}.semicon-level-label{display:inline-block;padding:.2em .55em;border-radius:999px;background:#1f6fbf;color:#fff;font-size:.86em;font-weight:700}.semicon-level strong{font-size:1.12em;color:#10233f}.semicon-level p{margin:.35em 0 0;color:#526071;font-size:.93em}.semicon-figure{margin:1.5em 0;padding:1em;border:1px solid var(--line);border-radius:16px;background:#f8fbff}.semicon-figure img{display:block;width:100%;height:auto;border-radius:12px}.semicon-figure figcaption{margin:.75em 0 0;color:#526071;font-size:.92em}.semicon-mobile-summary{display:none;margin:-.4em 0 1.4em;padding:1em 1.1em;border:1px solid #b9d7ff;border-radius:12px;background:#fff}.semicon-mobile-summary b{display:block;color:var(--blue);margin-bottom:.4em}.semicon-mobile-summary ul{margin:.2em 0 0;padding-left:1.25em}.semicon-mobile-summary li{margin:.25em 0}.semicon-map{margin:1.4em 0;padding:1.1em 1.2em;border:1px solid #b9d7ff;border-radius:16px;background:#f5faff}.semicon-map h3{margin:.1em 0 .6em;font-size:1.08em}.semicon-map ol{margin:.2em 0 0;padding-left:1.45em}.semicon-map 